# Application Settings
APP_NAME=Amazon Hunter Pro
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=500

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/amazon_hunter
TRACKING_DATABASE_URL=sqlite:///./web_app/backend/data/amazon_hunter.db
REDIS_URL=redis://localhost:6379/0

# Scraping Settings
SCRAPING_ENABLED=true
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=5
MAX_RETRIES=3

# Proxy Settings (Optional - for production)
USE_PROXY=false
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# External Services (Optional)
CAPTCHA_SOLVER_API_KEY=
BRIGHT_DATA_PROXY_URL=
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Amazon Hunter Pro

# Amazon Settings
AMAZON_BASE_URL=https://www.amazon.com
USER_AGENT_ROTATION=true

# Cache Settings
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Background Jobs
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api
